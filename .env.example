# Copy this file to .env.local and fill in what you have. Everything is optional:
# without keys, online payment buttons are hidden and orders go through WhatsApp.

# Public address of the site (used for links and SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack: dashboard.paystack.com → Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Flutterwave: app.flutterwave.com → Settings → API Keys
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# Email for paid orders and the request form (resend.com, free tier is fine)
RESEND_API_KEY=
ORDER_EMAIL_TO=
# Use an address on a domain you verified in Resend, e.g. "LuckyTech <orders@luckytechstore.com>"
ORDER_EMAIL_FROM=
